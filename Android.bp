android_app {
    name: "RomDownloader",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "26",
    target_sdk_version: "34",
    certificate: "platform",
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
    optimize: {
        enabled: false,
    },
}
